# Required: Fireworks API key (fw_... ) — the generation agent runs on Fireworks'
# Anthropic-compatible gateway, so no Anthropic key is needed.
FIREWORKS_API_KEY=fw_...

# Optional: Fireworks model. Defaults to "kimi-latest", the alias that tracks the
# current Kimi flagship. Pin a canonical id for reproducible builds, e.g.
# accounts/fireworks/models/kimi-k2-thinking
FIREWORKS_MODEL=kimi-latest

# Optional: override the Anthropic-compatible gateway base URL
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference

# Optional: cap the agent loop (default 60)
# OUTBREAK_MAX_TURNS=60

# Required for PR creation: GitHub personal access token (repo scope)
GITHUB_TOKEN=ghp_...

# Required for PR creation: owner/repo format
GITHUB_REPO=your-org/outbreak

# Optional: GitHub API base, for GitHub Enterprise Server
# GITHUB_API_URL=https://api.github.com
